# Copy to .env (in te-deployment/) to override any default. docker-compose.yml
# reads it; every value below is already the default, so .env is optional.

# --- te-infra ------------------------------------------------------------
POSTGRES_USER=trends
POSTGRES_PASSWORD=trends_dev_pw
POSTGRES_DB=trends
RABBITMQ_USER=trends
RABBITMQ_PASS=trends_dev_pw
# Ports published on your Mac (change if something else already uses them)
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
API_HOST_PORT=8080
UI_HOST_PORT=3000                   # te-ui: http://localhost:3000
MAILCHIMP_FAKE_PORT=8090            # fake Mailchimp API: http://localhost:8090/3.0

# --- te-connector (fixture replay) ----------------------------------------
CONNECTOR_BATCH_SIZE=5               # posts per simulated poll (50 replays the day in ~15 min)
CONNECTOR_POLL_INTERVAL_SECONDS=30
CONNECTOR_LOOP_FIXTURE=true          # replays after the first add nothing: dedup is permanent
CONNECTOR_SOURCE_ID=src_tiktok_hashtag

# --- te-normalizer ----------------------------------------------------------
NORMALIZER_RELEVANCE_THRESHOLD=0.5
NORMALIZER_PREFETCH=50

# --- te-detector (hashtag spikes) ------------------------------------------------
DETECTOR_WINDOW_MINUTES=60
DETECTOR_EWMA_ALPHA=0.3
DETECTOR_Z_THRESHOLD=3.0
DETECTOR_MIN_COUNT=4
DETECTOR_WARMUP_WINDOWS=2
DETECTOR_IDLE_FLUSH_SECONDS=120

# --- te-cluster (semantic clusters) -------------------------------------------
CLUSTER_SIMILARITY_THRESHOLD=0.72    # uncalibrated design-doc default: tune with `make -C te-cluster eval`
CLUSTER_EVICT_AFTER_HOURS=24
CLUSTER_BATCH_SIZE=64
CLUSTER_BATCH_WAIT_MS=50
CLUSTER_WINDOW_MINUTES=60
CLUSTER_Z_THRESHOLD=3.0
CLUSTER_MIN_COUNT=4

# --- te-aggregator ------------------------------------------------------------
AGGREGATOR_FALLBACK_SECONDS=300
AGGREGATOR_DEBOUNCE_SECONDS=20
AGGREGATOR_MAX_WAIT_SECONDS=90
AGGREGATOR_TOP_N=10
AGGREGATOR_LOOKBACK_HOURS=6
AGGREGATOR_SPARKLINE_HOURS=12

# --- te-api ---------------------------------------------------------------------
API_DEFAULT_LIMIT=20
API_MAX_LIMIT=100

# --- e2e ------------------------------------------------------------------------
E2E_PIPELINE_TIMEOUT_SECONDS=600
E2E_CYCLE_TIMEOUT_SECONDS=150

# --- te-api: Mailchimp (POST /v1/campaigns/draft-block) ------------------------
# The PoC talks to te-infra's mailchimp-fake. For the real API set
# MAILCHIMP_API_URL=https://<dc>.api.mailchimp.com/3.0 and a real key.
MAILCHIMP_API_URL=http://mailchimp-fake:8090/3.0
MAILCHIMP_API_KEY=fake-key-us1
MAILCHIMP_FROM_NAME=Trends Engine
MAILCHIMP_REPLY_TO=hello@example.com
